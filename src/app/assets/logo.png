f",33],["EmptyRef",33],["Ref",361],["Reactive",362],["Map"],["Ref",364],["Reactive",365],["Map"],["Ref",367],["Reactive",368],["Map"],["Ref",370],["Reactive",371],["Map",185,372],{"lesson":373,"lessonDifficulty":408,"chapterNumber":410,"lessonNumber":411},{"uuid":185,"slug":374,"type":375,"createdAt":376,"title":186,"topics":377,"generateChallenge":10,"absoluteDifficulty":381,"canonicalURL":-1,"courseUUID":156,"courseTitle":382,"courseImageURL":383,"courseSlug":384,"chapterUUID":160,"chapterTitle":161,"chapterSlug":385,"isFree":10,"lastMod":386,"codeLastMod":387,"lessonDataCLI":388},"8-image","type_cli","2023-02-27T00:00:00Z",[378,379,380],"Express Static Middleware","Static File Serving","MIME Types",31,"Learn HTTP Servers in TypeScript","","learn-http-servers-typescript","1-servers","2026-08-25T10:06:07+02:00","2026-08-19T10:20:05+02:00",{"readme":389,"cliData":390},"# Serving Images\n\nYou may be wondering how the fileserver knew to serve the `index.html` file to the root of the server. It's _such_ a common convention on the web to use a file called `index.html` to serve the webpage for a given path, that many file-serving libraries do it automatically.\n\nWhen using a standard fileserver, the path to a file on disk is the same as its URL path. An exception is that `index.html` is often served from `\u002F` instead of `\u002Findex.html`.\n\n## Try It Out\n\nRun your chirpy server again, and open `http:\u002F\u002Flocalhost:8080\u002Findex.html` in a new browser tab. You'll notice that you're served the same content as if you went to `http:\u002F\u002Flocalhost:8080\u002F`.\n\nThis works for all directories, not just the root!\n\nFor example:\n\n- `\u002Findex.html` will be served from `\u002F`\n- `\u002Fpages\u002Findex.html` will be served from `\u002Fpages`\n- `\u002Fpages\u002Fabout\u002Findex.html` will be served from `\u002Fpages\u002Fabout`\n\nAlternatively, try opening a URL that doesn't exist, like `http:\u002F\u002Flocalhost:8080\u002Fdoesntexist.html`. You'll see that the fileserver returns a 404 error.\n\n## Assignment\n\nLet's serve another type of file from our server: an image. Chirpy has a slick logo, and we need to serve it so that our users can load it in their browsers and mobile apps.\n\n1. [ ] Download the Chirpy logo from below and add it to your project directory.\n\n![Chirpy logo](https:\u002F\u002Fstorage.googleapis.com\u002Fqvault-webapp-dynamic-assets\u002Fcourse_assets\u002F2CofkLc-256x256.png)\n\n2. [ ] Configure its filepath so that it's accessible from this URL:\n\n```\nhttp:\u002F\u002Flocalhost:8080\u002Fassets\u002Flogo.png\n```\n\n**Run and submit** the CLI tests.\n",{"containsCompleteDir":10,"baseURLDefault":391,"steps":392,"allowedOperatingSystems":405},"http:\u002F\u002Flocalhost:8080",[393],{"description":383,"cliCommand":-1,"httpRequest":394,"noPenaltyOnFail":18},{"request":395,"tests":398,"responseVariables":-1,"responseHeaderVariables":-1,"sleepAfterMs":-1},{"method":396,"fullURL":397,"headers":-1,"bodyJSON":-1,"bodyForm":-1,"followRedirects":-1,"basicAuth":-1},"GET","${baseURL}\u002Fassets\u002Flogo.png",[399,401],{"statusCode":400,"bodyContains":-1,"bodyContainsNone":-1,"headersEqual":-1,"headersContain":-1,"trailersEqual":-1,"trailersContain":-1,"jsonValue":-1},200,{"statusCode":-1,"bodyContains":-1,"bodyContainsNone":-1,"headersEqual":402,"headersContain":-1,"trailersEqual":-1,"trailersContain":-1,"jsonValue":-1},{"key":403,"value":404},"Content-Type","image\u002Fpng",[406,407],"linux","darwin",{"score":409,"isCalibrating":18},3,1,8,["Ref",413],["Reactive",414],["Map"],["EmptyRef",69],["EmptyRef",33],["Ref",418],["Reactive",419],["Map"],["Ref",421],["Reactive",422],{},["Ref",424],["Reactive",425],["Map"],["Ref",427],["Reactive",428],["Map"],["Ref",430],["Reactive",431],["Map"],["Ref",433],["Reactive",434],["Map"],["Ref",436],["Reactive",437],["Map"],["Ref",439],["Reactive",440],["Map"],["Ref",442],["Reactive",443],["Map"],["Ref",445],["Reactive",446],["Map"],["Ref",448],["Reactiv